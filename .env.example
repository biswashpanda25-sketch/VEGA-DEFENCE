# Copy to .env and set real values. Never commit .env.
DATABASE_URL=sqlite:///./gotham.db
SECRET_KEY=replace-with-32-byte-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
SEED_DEMO=true

# AI provider: grounded-local (default, deterministic) | ollama | openai-compatible
AI_PROVIDER=grounded-local
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

DB_PASSWORD=
REDIS_URL=redis://localhost:6379/0
